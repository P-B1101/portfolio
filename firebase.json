{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "README.md",
      "LICENSE",
      "**/.*",
      "**/node_modules/**",
      "cv/build.mjs",
      "cv/content/**",
      "cv/icons/**"
    ],
    "headers": [
      {
        "source": "**/*.@(css|js|jpg|webp|png|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      }
    ]
  }
}
